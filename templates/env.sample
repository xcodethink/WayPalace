# WayPalace environment variables — copy to ~/.waypalace.env and source from your shell.
#
# All variables have sensible defaults if unset; override only what you need to change.

# Where WayPalace lives
export WAYPALACE_HOME="$HOME/.waypalace"

# Where memory data lives (chromadb, sparse store, metrics, archive, logs)
export WAYPALACE_DATA="$WAYPALACE_HOME/data"

# Python virtual environment
export WAYPALACE_VENV="$WAYPALACE_HOME/venv"

# Optional: MLX LLM (Tier 2 only)
export MLX_LLM_HOME="$HOME/.mlx-llm"

# Optional: where your projects live (used by hooks to detect cwd context)
export USER_WORKSPACE="$HOME/Developer"

# Optional: classification log location (auto-defaults under WAYPALACE_DATA/logs/)
# export WAYPALACE_CLASSIFY_LOG="$WAYPALACE_DATA/logs/classify_decisions.jsonl"
